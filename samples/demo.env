# ── AI Provider Keys ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-yourkey
OPENAI_API_KEY=sk-proj-yourkey
GEMINI_API_KEY=AIzaSyYourKey
GROQ_API_KEY=gsk_yourkey

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://admin:supersecret@localhost:5432/myapp
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=another-secret-value

# ── App Config ────────────────────────────────────────────────────────────────
APP_NAME=MyApp
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_AI_FEATURES=true
ENABLE_BETA_UI=false
MAX_TOKENS=4096
