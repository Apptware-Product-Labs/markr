{
  "name": "markr",
  "displayName": "Markr – Markdown Preview",
  "description": "Markdown preview & AI config editor for VS Code — Activity Bar panel, CLAUDE.md / .cursorrules / Copilot / Windsurf support, GitHub rendering, Mermaid, split editing, TOC, themes, PDF export",
  "version": "3.7.2",
  "publisher": "Apptware-Product-Lab",
  "author": {
    "name": "Apptware Labs Pvt Ltd",
    "email": "sumit.patil@apptware.com",
    "url": "https://apptware.com"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1c1a17",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apptware-Product-Labs/markr"
  },
  "bugs": {
    "url": "https://github.com/Apptware-Product-Labs/markr/issues"
  },
  "homepage": "https://apptware.com",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown preview",
    "markdown editor",
    "markdown viewer",
    "markdown-preview",
    "github markdown",
    "md preview",
    "ai config editor",
    "ai config",
    "claude code",
    "claude",
    "cursorrules",
    "copilot",
    "windsurf",
    "cursor",
    "mermaid",
    "toc",
    "diagrams",
    "notebook",
    "viewer",
    "editor",
    "pdf export",
    "split editor",
    "preview",
    "markr",
    "ai",
    "agents",
    "skills",
    "ai docs",
    "llm"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onView:markrExplorer",
    "onCommand:markr.newAiConfig",
    "onCommand:markr.openFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markr-sidebar",
          "title": "Markr",
          "icon": "images/markr-sidebar.svg"
        }
      ]
    },
    "views": {
      "markr-sidebar": [
        {
          "id": "markrExplorer",
          "name": "Markdown & AI Configs",
          "contextualTitle": "Markr"
        }
      ]
    },
    "commands": [
      {
        "command": "markr.openPreview",
        "title": "Open Markr Preview",
        "category": "Markr",
        "icon": "$(open-preview)"
      },
      {
        "command": "markr.openShowcase",
        "title": "Open Feature Showcase",
        "category": "Markr",
        "icon": "$(preview)"
      },
      {
        "command": "markr.pastePreview",
        "title": "Paste Markdown to Preview",
        "category": "Markr",
        "icon": "$(clippy)"
      },
      {
        "command": "markr.openFile",
        "title": "Open in Markr",
        "category": "Markr",
        "icon": "$(open-preview)"
      },
      {
        "command": "markr.newAiConfig",
        "title": "New AI Config File",
        "category": "Markr",
        "icon": "$(add)"
      },
      {
        "command": "markr.refreshExplorer",
        "title": "Refresh Explorer",
        "category": "Markr",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "markr.newAiConfig",
          "when": "view == markrExplorer",
          "group": "navigation@1"
        },
        {
          "command": "markr.refreshExplorer",
          "when": "view == markrExplorer",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "markr.openFile",
          "when": "view == markrExplorer && viewItem =~ /markrFile/",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "markr.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markr.openPreview",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markr.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markr.openPreview",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "markr.pastePreview",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "!editorFocus"
      }
    ],
    "configuration": {
      "title": "Markr",
      "properties": {
        "markr.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Sync preview scroll position with editor cursor position"
        },
        "markr.showTOC": {
          "type": "boolean",
          "default": true,
          "description": "Show Table of Contents panel by default"
        },
        "markr.maxWorkspaceFiles": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Maximum number of Markdown files to show in the Markr workspace file panel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --minify",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^9.0.0",
    "marked-highlight": "^2.0.0"
  }
}
