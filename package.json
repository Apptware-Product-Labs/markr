{
  "name": "markr",
  "displayName": "Markr",
  "description": "Fast Markdown preview for VS Code with workspace navigation, AI docs support, GitHub-style rendering, split editing, themes, and export tools",
  "version": "3.6.0",
  "publisher": "Apptware-Product-Lab",
  "author": {
    "name": "Apptware Labs Pvt Ltd",
    "email": "sumit.patil@apptware.com",
    "url": "https://apptware.com"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1c1a17",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apptware-Product-Labs/markr"
  },
  "bugs": {
    "url": "https://github.com/Apptware-Product-Labs/markr/issues"
  },
  "homepage": "https://apptware.com",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "markdown-preview",
    "github-markdown",
    "documentation",
    "ai",
    "agents",
    "skills",
    "preview",
    "notebook",
    "reader",
    "viewer",
    "editor",
    "markr",
    "md",
    "mermaid",
    "toc"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markr.openPreview",
        "title": "Open Markr Preview",
        "category": "Markr",
        "icon": "$(open-preview)"
      },
      {
        "command": "markr.openShowcase",
        "title": "Open Feature Showcase",
        "category": "Markr",
        "icon": "$(preview)"
      },
      {
        "command": "markr.pastePreview",
        "title": "Paste Markdown to Preview",
        "category": "Markr",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markr.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markr.openPreview",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markr.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markr.openPreview",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "markr.pastePreview",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "!editorFocus"
      }
    ],
    "configuration": {
      "title": "Markr",
      "properties": {
        "markr.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Sync preview scroll position with editor cursor position"
        },
        "markr.showTOC": {
          "type": "boolean",
          "default": true,
          "description": "Show Table of Contents panel by default"
        },
        "markr.maxWorkspaceFiles": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Maximum number of Markdown files to show in the Markr workspace file panel"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --minify",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^9.0.0",
    "marked-highlight": "^2.0.0"
  }
}
