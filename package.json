{
  "name": "markr",
  "displayName": "Markr – AI Config Editor & Markdown Preview",
  "description": "The AI config editor & Markdown preview for VS Code — auto-opens CLAUDE.md / .cursorrules / agent.md in split-edit mode, real-time Agent Watch (live preview while Claude edits), copy diagrams as PNG, rich copy to Slack, Mermaid, TOC, themes, PDF export",
  "version": "4.0.2",
  "publisher": "Apptware-Product-Lab",
  "author": {
    "name": "Apptware Labs Pvt Ltd",
    "email": "sumit.patil@apptware.com",
    "url": "https://apptware.com"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1c1a17",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Apptware-Product-Labs/markr"
  },
  "bugs": {
    "url": "https://github.com/Apptware-Product-Labs/markr/issues"
  },
  "homepage": "https://apptware.com",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "markdown",
    "markdown preview",
    "markdown editor",
    "markdown viewer",
    "github markdown",
    "md preview",
    "ai config editor",
    "ai config",
    "claude code",
    "claude md",
    "claude",
    "cursorrules",
    "cursor rules",
    "copilot",
    "copilot instructions",
    "windsurf",
    "cursor",
    "agent watch",
    "live preview",
    "real-time preview",
    "agent config",
    "agent editor",
    "ai agent",
    "mermaid",
    "mermaid diagram",
    "toc",
    "diagrams",
    "notebook",
    "viewer",
    "editor",
    "pdf export",
    "split editor",
    "preview",
    "markr",
    "ai",
    "agents",
    "skills",
    "ai docs",
    "llm",
    "context window",
    "token counter"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onView:markrExplorer",
    "onCommand:markr.newAiConfig",
    "onCommand:markr.openFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markr-sidebar",
          "title": "Markr",
          "icon": "images/markr-sidebar.svg"
        }
      ]
    },
    "views": {
      "markr-sidebar": [
        {
          "id": "markrExplorer",
          "name": "Markdown & AI Configs",
          "contextualTitle": "Markr"
        }
      ]
    },
    "commands": [
      {
        "command": "markr.openPreview",
        "title": "Open Markr Preview",
        "category": "Markr",
        "icon": "$(open-preview)"
      },
      {
        "command": "markr.openShowcase",
        "title": "Open Feature Showcase",
        "category": "Markr",
        "icon": "$(preview)"
      },
      {
        "command": "markr.pastePreview",
        "title": "Paste Markdown to Preview",
        "category": "Markr",
        "icon": "$(clippy)"
      },
      {
        "command": "markr.openFile",
        "title": "Open in Markr",
        "category": "Markr",
        "icon": "$(open-preview)"
      },
      {
        "command": "markr.newAiConfig",
        "title": "New AI Config File",
        "category": "Markr",
        "icon": "$(add)"
      },
      {
        "command": "markr.refreshExplorer",
        "title": "Refresh Explorer",
        "category": "Markr",
        "icon": "$(refresh)"
      },
      {
        "command": "markr.searchFiles",
        "title": "Search Files",
        "category": "Markr",
        "icon": "$(search)"
      },
      {
        "command": "markr.setApiKey",
        "title": "Set API Key for Prompt Runner",
        "category": "Markr",
        "icon": "$(key)"
      },
      {
        "command": "markr.clearPromptHistory",
        "title": "Clear Prompt History",
        "category": "Markr",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "markr.newAiConfig",
          "when": "view == markrExplorer",
          "group": "navigation@1"
        },
        {
          "command": "markr.searchFiles",
          "when": "view == markrExplorer",
          "group": "navigation@2"
        },
        {
          "command": "markr.refreshExplorer",
          "when": "view == markrExplorer",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "markr.openFile",
          "when": "view == markrExplorer && viewItem =~ /markrFile/",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "markr.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markr.openPreview",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markr.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markr.openPreview",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "markr.pastePreview",
        "key": "ctrl+shift+p",
        "mac": "cmd+shift+p",
        "when": "!editorFocus"
      }
    ],
    "configuration": {
      "title": "Markr",
      "properties": {
        "markr.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "Sync preview scroll position with editor cursor position"
        },
        "markr.showTOC": {
          "type": "boolean",
          "default": true,
          "description": "Show Table of Contents panel by default"
        },
        "markr.maxWorkspaceFiles": {
          "type": "number",
          "default": 500,
          "minimum": 50,
          "maximum": 5000,
          "description": "Maximum number of Markdown files to show in the Markr workspace file panel"
        },
        "markr.autoOpenAiConfigs": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, opening CLAUDE.md, .cursorrules, agent.md, or any AI config file automatically opens it in Markr alongside the text editor. Off by default — enable in Settings if you want this behaviour."
        },
        "markr.showTokenDecorations": {
          "type": "boolean",
          "default": true,
          "description": "Show inline token cost annotations at the end of each heading line in Markdown files (e.g. '~240 tok'). Turns orange for sections using more than 25% of the file's total tokens."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --minify",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^9.0.0",
    "marked-highlight": "^2.0.0"
  }
}
